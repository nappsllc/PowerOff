// App icon (generated by tools\make-icon.ps1). ID 1 = window, tray and Explorer icon.
1 ICON "poweroff.ico"

// Fluent color icons (tools\make-icons.ps1): 100 + IconId, 48 px masters scaled at runtime.
100 RCDATA "icons/power_48.png"
101 RCDATA "icons/restart_48.png"
102 RCDATA "icons/sleep_48.png"
103 RCDATA "icons/signout_48.png"
104 RCDATA "icons/lock_48.png"
105 RCDATA "icons/display_48.png"
106 RCDATA "icons/alert_48.png"
107 RCDATA "icons/apps_48.png"
108 RCDATA "icons/rocket_48.png"
109 RCDATA "icons/calclock_48.png"
110 RCDATA "icons/clock_48.png"
111 RCDATA "icons/alarm_48.png"
112 RCDATA "icons/hibernate_48.png"
